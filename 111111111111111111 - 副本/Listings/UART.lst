   1          #include <REGX52.H>
   2          /**
   3           *@brief 串口初始化，4800bps@12.000MHz
   4           *@param 输入参数无
   5           *@retval 返回值无
   6           */
   7          void UART_Init()    
   8          {
   9   1        SCON = 0x50;    //8位数据,可变波特率
  10   1        PCON |= 0x80;   //使能波特率倍速位SMOD
  11   1        TMOD &= 0x0F;   //清除定时器1模式位
  12   1        TMOD |= 0x20;   //设定定时器1为8位自动重装方式
  13   1        TL1 = 0xF4;   //设定定时初值
  14   1        TH1 = 0xF4;   //设定定时器重装值
  15   1        ET1 = 0;    //禁止定时器1中断
  16   1        TR1 = 1;    //启动定时器1
  17   1        EA=1;//ZHONGDUAN
  18   1      ES=1; 
  19   1      }
  20          /**
  21          *@brief 串口发送一个字节数据
  22          *@param Byte要发送的字节数据
  23          *@retval
  24          */
  25          void UART_SendByte(unsigned char Byte)
  26          {
  27   1        SBUF=Byte;//送向控制门，是被赋值的（上面的）
  28   1        while(TI==0);//检测，要完整发送出去
  29   1        TI=0;
  30   1      }


