   1          #include <REGX52.H>
   2          #include "Delay.h"
   3          #include "KEY.h"
   4          #include "LCD1602.h"
   5          #include "cai1.h"
   6          void UART_Init()    
   7          {
   8   1        SCON = 0x50;//40变50 电脑接收  
   9   1        PCON |= 0x80;   
  10   1        TMOD &= 0x0F;   
  11   1        TMOD |= 0x20;   
  12   1        TL1 = 0xF4;   
  13   1        TH1 = 0xF4;   
  14   1        ET1 = 0;    
  15   1        TR1 = 1;  
  16   1      EA=1;//ZHONGDUAN
