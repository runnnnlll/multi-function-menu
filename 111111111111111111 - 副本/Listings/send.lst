  18   1      }
  19          
  20          void UART_SendByte(unsigned char Byte)
  21          {
  22   1        SBUF = Byte;
  23   1        while(TI == 0); 
  24   1        TI = 0;//发送
  25   1      }
  26          
  27          int send()
  28          {
  29   1        unsigned char keyd;
  30   1        UART_Init();
  31   1        while(1)
  32   1        {
  33   2          LCD_Init();
  34   2          LCD_ShowString(1,1,"send");
  35   2          keyd=Key();
  36   2          if(keyd==3)
  37   2              { 
  38   3                  if(keyd==3)//再确认
  39   3                  {
  40   4                           return 0;
  41   4                  }
  42   3              }
  43   2        }
  44   1      }
  45          void UART_Routine() interrupt 4
  46          {
  47   1        if(RI==1)//接受
  48   1        {
  49   2          UART_SendByte(SBUF);
  50   2          RI=0;
  51   2        }
  52   1      }


